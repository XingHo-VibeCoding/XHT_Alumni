---
/**
 * Footer.astro — 全站页脚（REQ-005）
 * 仅含公司统一联系入口 + 导航 + 版权；不含任何个人联系方式（隐私红线）。
 */
import home from '../../data/home.json';
---

<footer class="border-t border-[var(--border-subtle)]">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 sm:px-6">
    <!-- 公司统一联系入口（主按钮：品牌渐变底 + 白字） -->
    <a
      href={home.contact.href}
      class="inline-flex h-10 items-center rounded-lg px-6 font-medium text-white"
      style="background: var(--brand-gradient);"
    >
      {home.contact.label}
    </a>

    <!-- 导航回链 -->
    <nav aria-label="页脚导航">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-[var(--text-tertiary)]">
        <li><a href="/" class="transition-colors hover:text-[var(--text-secondary)]">首页</a></li>
        <li><a href="#" class="transition-colors hover:text-[var(--text-secondary)]">星图</a></li>
        <li><a href="#" class="transition-colors hover:text-[var(--text-secondary)]">分享</a></li>
        <li><a href="#" class="transition-colors hover:text-[var(--text-secondary)]">金句</a></li>
        <li><a href="#" class="transition-colors hover:text-[var(--text-secondary)]">经历</a></li>
        <li><a href="#" class="transition-colors hover:text-[var(--text-secondary)]">校友会</a></li>
      </ul>
    </nav>

    <p class="text-[13px] text-[var(--text-tertiary)]">© 2026 星禾科技 Singho</p>
  </div>
</footer>
