---
/**
 * BaseLayout.astro — 全局壳（TCD 3 目录结构）
 * 负责：head 元信息、全局样式、固定导航、页脚、启动封面。
 * 每个页面只需传入 title / description 与插槽内容。
 */
import '../styles/global.css';
import Nav from '../components/common/Nav.astro';
import Footer from '../components/common/Footer.astro';
import IntroCover from '../components/home/IntroCover.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '星禾科技（Singho）——打造一家伟大的科技公司，给众人送去希望和梦想' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- 全站图案背景层：位图银河 + 亮星闪烁 + 低频流星（装饰性，不参与交互） -->
    <div class="site-bg" aria-hidden="true">
      <i class="meteor meteor-a"></i>
      <i class="meteor meteor-b"></i>
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <IntroCover />
  </body>
</html>
